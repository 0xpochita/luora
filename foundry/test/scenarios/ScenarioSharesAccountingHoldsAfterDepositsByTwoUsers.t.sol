pragma solidity ^0.8.20;

// Generated by Luora Lab from the scenario "Shares accounting holds after deposits by two users".
// It tests INTENDED behaviour: a failing assertion is a finding (see the Lab for the fix).
// Run: node luora-scenario.mjs ScenarioSharesAccountingHoldsAfterDepositsByTwoUsers.t.sol
import {Test} from "forge-std/Test.sol";
import {LuoraVault, IERC20, IOracle, IStrategy, IUniswapV2Router02} from "../../src/LuoraVault.sol";
import {MockOracle, MockStrategy, MockUSDC, MockUniswapRouter} from "../../src/mocks/Mocks.sol";

contract ScenarioSharesAccountingHoldsAfterDepositsByTwoUsersTest is Test {
    LuoraVault vault;
    MockUSDC usdc;
    address alice = makeAddr("alice");
    address bob = makeAddr("bob");

    function setUp() public {
        usdc = new MockUSDC();
        address oracle_ = address(new MockOracle());
        address strategy_ = address(new MockStrategy());
        address router_ = address(new MockUniswapRouter());
        address rewardToken_ = address(new MockUSDC());
        vault = new LuoraVault(IERC20(address(usdc)), IOracle(oracle_), IStrategy(strategy_), makeAddr("keeper"), IUniswapV2Router02(router_), IERC20(rewardToken_));
        usdc.mint(alice, 5_000e6);
        vm.prank(alice);
        usdc.approve(address(vault), type(uint256).max);
        usdc.mint(bob, 20_000e6);
        vm.prank(bob);
        usdc.approve(address(vault), type(uint256).max);
    }

    function test_scenario() public {
        // deposit
        vm.prank(alice);
        vault.deposit(1_000e6);
        // deposit
        vm.prank(bob);
        vault.deposit(20_000e6);
        assertEq(vault.totalShares(), vault.shares(alice) + vault.shares(bob) + vault.shares(vault.owner()), "totalShares == sum of shares");
        assertGe(usdc.balanceOf(address(vault)), vault.totalShares(), "vault holds at least totalShares");
    }
}
