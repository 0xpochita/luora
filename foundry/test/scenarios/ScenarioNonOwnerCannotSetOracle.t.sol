pragma solidity ^0.8.20;

// Generated by Luora Lab from the scenario "Non-owner cannot setOracle".
// It tests INTENDED behaviour: a failing assertion is a finding (see the Lab for the fix).
// Run: node luora-scenario.mjs ScenarioNonOwnerCannotSetOracle.t.sol
import {Test} from "forge-std/Test.sol";
import {LuoraVault, IERC20, IOracle, IStrategy, IUniswapV2Router02} from "../../src/LuoraVault.sol";
import {MockOracle, MockStrategy, MockUSDC, MockUniswapRouter} from "../../src/mocks/Mocks.sol";

contract ScenarioNonOwnerCannotSetOracleTest is Test {
    LuoraVault vault;
    MockUSDC usdc;
    address alice = makeAddr("alice");

    function setUp() public {
        usdc = new MockUSDC();
        address oracle_ = address(new MockOracle());
        address strategy_ = address(new MockStrategy());
        address router_ = address(new MockUniswapRouter());
        address rewardToken_ = address(new MockUSDC());
        vault = new LuoraVault(IERC20(address(usdc)), IOracle(oracle_), IStrategy(strategy_), makeAddr("keeper"), IUniswapV2Router02(router_), IERC20(rewardToken_));
        usdc.mint(alice, 1_000e6);
        vm.prank(alice);
        usdc.approve(address(vault), type(uint256).max);
    }

    function test_scenario() public {
        // setOracle
        vm.prank(alice);
        vm.expectRevert(bytes("!owner"));
        vault.setOracle(IOracle(address(0)));
        vm.prank(makeAddr("not_owner"));
        vm.expectRevert(bytes("!owner"));
        vault.setOracle(IOracle(address(0))); // only owner
    }
}
